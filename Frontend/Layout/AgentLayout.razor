@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@inject SmartHelpdesk.Client.Services.AuthService AuthService
@implements IDisposable
@using System.Text.Json

<div class="agent-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Smart Helpdesk</span>
            </div>
        </div>
        
        <nav class="sidebar-nav">
            <a href="/agent" class="nav-item @(IsActive("/agent") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
                <span>Dashboard</span>
            </a>
            <a href="/agent/tickets" class="nav-item @(IsActive("/agent/tickets") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Danh sách yêu cầu</span>
            </a>
            <a href="/agent/notifications" class="nav-item @(IsActive("/agent/notifications") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 0 0-4-5.7V4a2 2 0 1 0-4 0v1.3A6 6 0 0 0 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h5"></path>
                    <path d="M9 17a3 3 0 0 0 6 0"></path>
                </svg>
                <span>Thông báo</span>
                @if (unreadNotificationCount > 0)
                {
                    <span class="notification-badge">@unreadNotificationCount</span>
                }
            </a>
            <a href="/agent/profile" class="nav-item @(IsActive("/agent/profile") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Hồ sơ cá nhân</span>
            </a>
        </nav>
        
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="avatar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div class="user-details">
                    <span class="user-name">@userName</span>
                    <span class="user-role">Support Agent</span>
                </div>
            </div>
            <button class="logout-btn" @onclick="Logout">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </button>
        </div>
    </aside>
    
    <!-- Notification Toast -->
    @if (showNotification)
    {
        <div class="notification-toast @(notificationIsSuccess ? "success" : "info")">
            <div class="toast-icon">
                @if (notificationIsSuccess)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                }
            </div>
            <span>@notificationMessage</span>
        </div>
    }
    
    <!-- Main Content -->
    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private string userName = "Nhân viên";
    private bool showNotification = false;
    private string notificationMessage = "";
    private bool notificationIsSuccess = true;
    private int unreadNotificationCount = 0;
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Kiểm tra authentication
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/auth", forceLoad: true);
                return;
            }

            // Lấy tên user
            var name = await AuthService.GetUserNameAsync();
            if (!string.IsNullOrEmpty(name))
            {
                userName = name;
                StateHasChanged();
            }

            await LoadUnreadNotificationCount();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadUnreadNotificationCount();
            StateHasChanged();
        });
    }

    private async Task LoadUnreadNotificationCount()
    {
        try
        {
            var response = await Http.GetAsync("api/Notifications/my?unreadOnly=true&take=1");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var content = await response.Content.ReadAsStringAsync();
            var payload = JsonSerializer.Deserialize<NotificationCountResponse>(content, JsonOptions);
            unreadNotificationCount = payload?.UnreadCount ?? 0;
        }
        catch
        {
            // Keep layout resilient when notification API is unavailable.
        }
    }

    private bool IsActive(string path)
    {
        var currentPath = Navigation.Uri.Replace(Navigation.BaseUri, "/");
        if (path == "/agent")
        {
            return currentPath == "/agent" || currentPath == "/agent/";
        }
        return currentPath.StartsWith(path);
    }
    
    private async Task Logout()
    {
        await AuthService.RemoveTokenAsync();
        Navigation.NavigateTo("/auth", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed class NotificationCountResponse
    {
        public int UnreadCount { get; set; }
    }
}
