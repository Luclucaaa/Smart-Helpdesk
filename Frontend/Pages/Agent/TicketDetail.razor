    private async Task GenerateReplySuggestions()
    {
        if (ticket == null)
        {
            return;
        }

        isGeneratingReplySuggestions = true;
        replySuggestionError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/ai/suggest-reply", new
            {
                TicketId = Id,
                DraftReply = newComment,
                MaxSuggestions = 3
            });

            if (!response.IsSuccessStatusCode)
            {
                replySuggestionError = "Không lấy được gợi ý AI lúc này. Vui lòng thử lại.";
                return;
            }

            var data = await response.Content.ReadFromJsonAsync<AgentReplySuggestionApiResponse>();
            replySuggestionsSource = data?.Source;
            replySuggestions = data?.Suggestions?
                .Where(x => !string.IsNullOrWhiteSpace(x.Text))
                .ToList() ?? new List<AgentReplySuggestionItem>();
            suggestionFeedbackStates = new Dictionary<Guid, bool>();

            if (replySuggestions.Count == 0)
            {
                replySuggestionError = "AI chưa tạo được gợi ý phù hợp cho ticket này.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating reply suggestions: {ex.Message}");
            replySuggestionError = "Đã có lỗi khi tạo gợi ý phản hồi.";
        }
        finally
        {
            isGeneratingReplySuggestions = false;
        }
    }

    private async Task ApplyAiSuggestion(AgentReplySuggestionItem suggestion)
    {
        newComment = suggestion.Text;

        if (suggestion.SuggestionLogId != Guid.Empty)
        {
            try
            {
                await Http.PostAsync($"api/ai/suggest-reply/{suggestion.SuggestionLogId}/accept", null);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error marking suggestion accepted: {ex.Message}");
            }
        }
    }

    private async Task SendSuggestionFeedback(AgentReplySuggestionItem suggestion, bool isHelpful)
    {
        if (suggestion.SuggestionLogId == Guid.Empty)
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/ai/suggest-reply/{suggestion.SuggestionLogId}/feedback",
                new { IsHelpful = isHelpful, Note = (string?)null });

            if (response.IsSuccessStatusCode)
            {
                suggestionFeedbackStates[suggestion.SuggestionLogId] = isHelpful;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending suggestion feedback: {ex.Message}");
        }
    }

    private string GetFeedbackClass(Guid suggestionLogId, bool expected)
    {
        if (suggestionFeedbackStates.TryGetValue(suggestionLogId, out var actual) && actual == expected)
        {
            return "active";
        }

        return string.Empty;
    }

    private async Task SendComment()
    {
        if (string.IsNullOrWhiteSpace(newComment) || ticket == null) return;

        if (!currentUserId.HasValue)
        {
            await ShowActionNotification("❌ Không xác định được người dùng hiện tại. Vui lòng đăng nhập lại.", false);
            return;
        }
        
        isSending = true;
        try
        {
            // Gọi API để thêm comment
            var response = await Http.PostAsJsonAsync("api/Tickets/Comments/AddCommentToTicket", new 
            { 
                TicketId = Id, 
                UserId = currentUserId.Value,
                Text = newComment 
            });
            
            if (response.IsSuccessStatusCode)
            {
                // Reload comments sau khi thêm thành công
                await LoadTicketDetail();
                newComment = "";
                replySuggestions.Clear();
                replySuggestionsSource = null;
                suggestionFeedbackStates.Clear();
                await ShowActionNotification("✅ Đã gửi phản hồi cho khách hàng.", true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowActionNotification(string.IsNullOrWhiteSpace(error) ? "❌ Gửi phản hồi thất bại." : $"❌ {error}", false);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending comment: {ex.Message}");
            await ShowActionNotification("❌ Có lỗi khi gửi phản hồi.", false);
        }
        finally
        {
            isSending = false;
        }
    }

    private void StartCommentsPolling()
    {
        commentsPollingCts = new CancellationTokenSource();
        _ = PollCommentsAsync(commentsPollingCts.Token);
    }

    private void StopCommentsPolling()
    {
        commentsPollingCts?.Cancel();
        commentsPollingCts?.Dispose();
        commentsPollingCts = null;
    }

    private async Task PollCommentsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (!isLoading && !isSending && ticket != null)
                    {
                        await LoadCommentsOnly();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when navigating away.
        }
    }

    private async Task LoadCommentsOnly()
    {
        try
        {
            var response = await Http.GetAsync($"api/Tickets/Comments/GetCommentsToTicket/{Id}");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var content = await response.Content.ReadAsStringAsync();
            var latest = JsonSerializer.Deserialize<List<CommentResponse>>(content, JsonOptions) ?? new List<CommentResponse>();

            var mapped = latest.Select(c => new CommentDto
            {
                Id = c.Id,
                Content = c.Text,
                IsFromAgent = c.IsFromAgent,
                SenderName = c.UserName,
                CreatedAt = c.CreatedAt
            }).ToList();

            if (!AreCommentsEqual(comments, mapped))
            {
                comments = mapped;
                StateHasChanged();
            }
        }
        catch
        {
            // Keep screen stable when polling fails intermittently.
        }
    }

    private static bool AreCommentsEqual(List<CommentDto> current, List<CommentDto> incoming)
    {
        if (current.Count != incoming.Count)
        {
            return false;
        }

        for (var i = 0; i < current.Count; i++)
        {
            if (current[i].Id != incoming[i].Id)
            {
                return false;
            }
        }

        return true;
    }

    public void Dispose()
    {
        StopCommentsPolling();
    }

    private async Task UpdateStatus(int newStatus)
    {
        if (ticket == null) return;

        if (!IsMyTicket)
        {
            await ShowActionNotification("❌ Bạn chỉ có thể đổi trạng thái ticket do chính bạn phụ trách.", false);
            return;
        }
        
        isUpdatingStatus = true;
        try
        {
            // Gọi API để cập nhật trạng thái
            var response = await Http.PatchAsJsonAsync($"api/Tickets/UpdateTicketStatus/{Id}", new 
            { 
                Status = newStatus 
            });
            
            if (response.IsSuccessStatusCode)
            {
                ticket.Status = newStatus;
                await ShowActionNotification("✅ Đã cập nhật trạng thái ticket.", true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowActionNotification(string.IsNullOrWhiteSpace(error) ? "❌ Cập nhật trạng thái thất bại." : $"❌ {error}", false);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating status: {ex.Message}");
            await ShowActionNotification("❌ Có lỗi khi cập nhật trạng thái.", false);
        }
        finally
        {
            isUpdatingStatus = false;
        }
    }

    private async Task SelfAssignTicket()
    {
        if (ticket == null) return;
        isSelfAssigning = true;
        try
        {
            var response = await Http.PostAsync($"api/Tickets/SelfAssign/{Id}", null);
            if (response.IsSuccessStatusCode)
            {
                // Reload ticket to get updated assignee info
                await LoadTicketDetail();
                await ShowActionNotification("✅ Bạn đã nhận ticket này thành công!", true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                var message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "❌ Ticket này đã có nhân viên khác nhận. Vui lòng tải lại danh sách."
                    : string.IsNullOrWhiteSpace(error)
                        ? "❌ Không thể nhận ticket. Vui lòng thử lại."
                        : $"❌ {error}";

                    await ShowActionNotification(message, false);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error self-assigning: {ex.Message}");
                await ShowActionNotification("❌ Có lỗi khi nhận ticket.", false);
        }
        finally
        {
            isSelfAssigning = false;
        }
    }

        private async Task StartProcessingTicket()
        {
            if (ticket == null) return;

            if (!ticket.AssignedToId.HasValue)
            {
                await SelfAssignTicket();
            }

            if (ticket.Status != 1)
            {
                await UpdateStatus(1);
            }
        }

        private async Task CloseTicketQuickly()
        {
            if (ticket == null || !IsMyTicket) return;

            if (string.IsNullOrWhiteSpace(newComment))
            {
                newComment = "Vấn đề của bạn đã được xử lý xong. Vui lòng kiểm tra và phản hồi nếu còn cần hỗ trợ thêm.";
            }

            await UpdateStatus(2);
        }

        private async Task ReopenTicket()
        {
            if (ticket == null || !IsMyTicket) return;
            await UpdateStatus(1);
        }

        private async Task ShowActionNotification(string message, bool success)
    {
        actionToastMessage = message;
        actionToastSuccess = success;
        showActionToast = true;
        StateHasChanged();
        await Task.Delay(4000);
        showActionToast = false;
        StateHasChanged();
    }

