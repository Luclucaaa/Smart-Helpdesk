            new() { Title = "🙏 Xin lỗi & đang xử lý", Text = "Chân thành xin lỗi về sự bất tiện này. Chúng tôi đang khẩn trương khắc phục và sẽ thông báo ngay khi hoàn tất." },
            new() { Title = "✅ Đã giải quyết xong", Text = "Vấn đề của bạn đã được xử lý xong. Vui lòng kiểm tra và phản hồi nếu còn thắc mắc." }
