            });
        }

        if (category == 2)
        {
            defaults.Insert(0, new CannedResponseOption
            {
                Title = "📄 Hướng dẫn sử dụng",
                Text = "Mình gửi bạn hướng dẫn sử dụng chi tiết. Bạn vui lòng thử theo từng bước và phản hồi giúp mình nhé."
