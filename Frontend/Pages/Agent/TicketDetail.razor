@page "/agent/ticket/{Id:guid}"
@page "/agent/tickets/{Id:guid}"
@layout AgentLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Net.Http.Json
@using System.Text.Json
@implements IDisposable

<PageTitle>Chi tiết yêu cầu hỗ trợ - Agent Dashboard</PageTitle>

<div class="ticket-detail-page">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="loader"></div>
            <p>Đang tải thông tin...</p>
        </div>
    }
    else if (ticket == null)
    {
        <div class="not-found">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <p>Không tìm thấy yêu cầu này</p>
            <a href="/agent/tickets" class="btn-back">Quay lại danh sách</a>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="page-header">
            <a href="/agent/tickets" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Quay lại danh sách
            </a>
            <div class="header-info">
                <div class="ticket-id-section">
                    <span class="ticket-id">#@ticket.Id.ToString().Substring(0, 8).ToUpper()</span>
                    @if (ticket.SentimentScore < 0.4)
                    {
                        <span class="sentiment-badge negative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="8" y1="15" x2="16" y2="15"></line>
                                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                <line x1="15" y1="9" x2="15.01" y2="9"></line>
                            </svg>
                            Khách hàng không hài lòng
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="content-grid">
            <!-- Main Content -->
            <div class="main-content">
                <!-- Ticket Info Card -->
                <div class="info-card">
                    <div class="card-header">
                        <h3>Thông tin yêu cầu</h3>
                        <span class="status-badge @GetStatusClass(ticket.Status)">@GetStatusText(ticket.Status)</span>
                    </div>
                    
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">Khách hàng</span>
                            <div class="customer-info">
                                <span class="name">@ticket.UserName</span>
                                <span class="email">@ticket.UserEmail</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="label">Sản phẩm</span>
                            <span class="value product">@ticket.ProductName</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Phân loại (AI)</span>
                            <span class="value category @GetCategoryClass(ticket.Category)">@GetCategoryText(ticket.Category)</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Độ ưu tiên (AI)</span>
                            <span class="value priority @GetPriorityClass(ticket.Priority)">@GetPriorityText(ticket.Priority)</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Điểm cảm xúc</span>
                            <div class="sentiment-score">
                                <div class="score-bar">
                                    <div class="score-fill @(ticket.SentimentScore < 0.4 ? "negative" : "positive")" 
                                         style="width: @((ticket.SentimentScore ?? 0.5) * 100)%"></div>
                                </div>
                                <span class="score-value">@((ticket.SentimentScore ?? 0.5).ToString("P0"))</span>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="label">Ngày tạo</span>
                            <span class="value">@ticket.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                    </div>
                    
                    <div class="description-section">
                        <h4>Mô tả vấn đề</h4>
                        <p>@ticket.Description</p>
                    </div>
                    
                    @if (ticket.Attachments?.Count > 0)
                    {
                        <div class="attachments-section">
                            <h4>File đính kèm</h4>
                            <div class="attachments-list">
                                @foreach (var file in ticket.Attachments)
                                {
                                    <a href="@file.Url" target="_blank" class="attachment-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                                            <polyline points="13 2 13 9 20 9"></polyline>
                                        </svg>
                                        <span>@file.FileName</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Chat Section -->
                <div class="chat-card">
                    <div class="card-header">
                        <h3>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            Trao đổi với khách hàng
                        </h3>
                        <span class="message-count">@comments.Count tin nhắn</span>
                    </div>
                    
                    <div class="chat-messages">
                        @if (comments.Count == 0)
                        {
                            <div class="no-messages">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <p>Chưa có tin nhắn nào</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var comment in comments)
                            {
                                <div class="message @(comment.IsFromAgent ? "agent" : "customer")">
                                    <div class="message-avatar">
                                        @if (comment.IsFromAgent)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="12" cy="7" r="4"></circle>
                                            </svg>
                                        }
                                    </div>
                                    <div class="message-content">
                                        <div class="message-header">
                                            <span class="sender-name">@(comment.IsFromAgent ? comment.SenderName : "Khách hàng")</span>
                                            <span class="message-time">@comment.CreatedAt.ToString("HH:mm - dd/MM")</span>
                                        </div>
                                        <p class="message-text">@comment.Content</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    
                    @if (ticket.Status != 2)
                    {
                        <div class="chat-input-area">
                            <div class="agent-ai-tools">
                                <button class="btn-ai-reply" @onclick="GenerateReplySuggestions" disabled="@isGeneratingReplySuggestions">
                                    @if (isGeneratingReplySuggestions)
                                    {
                                        <span class="spinner-small"></span>
                                        <span>AI đang tạo gợi ý...</span>
                                    }
                                    else
                                    {
                                        <span>AI gợi ý phản hồi</span>
                                    }
                                </button>

                                @if (!string.IsNullOrWhiteSpace(replySuggestionsSource))
                                {
                                    <span class="ai-source">Nguồn: @replySuggestionsSource</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(replySuggestionError))
                            {
                                <div class="ai-error">@replySuggestionError</div>
                            }

                            @if (replySuggestions.Count > 0)
                            {
                                <div class="ai-suggestion-list">
                                    @foreach (var suggestion in replySuggestions)
                                    {
                                        <div class="ai-suggestion-item">
                                            <button type="button" class="ai-suggestion-select" @onclick='() => ApplyAiSuggestion(suggestion)'>
                                                <span class="ai-suggestion-text">@suggestion.Text</span>
                                                <span class="ai-meta">@suggestion.Source • @suggestion.Confidence.ToString("P0")</span>
                                            </button>
                                            <div class="ai-actions">
                                                <button type="button"
                                                        class="btn-ai-feedback @(GetFeedbackClass(suggestion.SuggestionLogId, true))"
                                                        @onclick='() => SendSuggestionFeedback(suggestion, true)'>
                                                    Hữu ích
                                                </button>
                                                <button type="button"
                                                        class="btn-ai-feedback @(GetFeedbackClass(suggestion.SuggestionLogId, false))"
                                                        @onclick='() => SendSuggestionFeedback(suggestion, false)'>
                                                    Chưa hữu ích
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <textarea @bind="newComment" 
                                      placeholder="Nhập phản hồi cho khách hàng..." 
                                      rows="3"></textarea>
                            <button class="btn-send" @onclick="SendComment" disabled="@(string.IsNullOrWhiteSpace(newComment) || isSending)">
                                @if (isSending)
                                {
                                    <span class="spinner-small"></span>
                                    <span>Đang gửi...</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                    <span>Gửi phản hồi</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar Actions -->
            <div class="sidebar-actions">
                <!-- Status Update Card -->
                <div class="action-card">
                    <h4>Cập nhật trạng thái</h4>
                    <div class="status-buttons">
                        <button class="status-btn @(ticket.Status == 0 ? "active" : "")" 
                                @onclick='() => UpdateStatus(0)'
                                disabled="@(!CanUpdateToStatus(0))">
                            <span class="dot new"></span>
                            Mới
                        </button>
                        <button class="status-btn @(ticket.Status == 1 ? "active" : "")" 
                                @onclick='() => UpdateStatus(1)'
                                disabled="@(!CanUpdateToStatus(1))">
                            <span class="dot in-progress"></span>
                            Đang xử lý
                        </button>
                        <button class="status-btn @(ticket.Status == 2 ? "active" : "")" 
                                @onclick='() => UpdateStatus(2)'
                                disabled="@(!CanUpdateToStatus(2))">
                            <span class="dot closed"></span>
                            Đã đóng
                        </button>
                    </div>
                </div>

                <!-- Assignee Card -->
                <div class="action-card">
                    <h4>Phụ trách</h4>
                    @if (ticket.AssignedToId.HasValue)
                    {
                        <div class="assignee-display">
                            <div class="assignee-avatar">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </div>
                            <div class="assignee-info">
                                <span class="assignee-name">@ticket.AssignedToName</span>
                                <span class="assignee-label">Nhân viên phụ trách</span>
                            </div>
                        </div>
                        @if (ticket.AssignedToId == currentUserId && ticket.Status != 2)
                        {
                            <div class="my-ticket-badge">
                                ✅ Đây là ticket của bạn
                            </div>
                        }
                    }
                    else if (ticket.Status != 2)
                    {
                        <div class="unassigned-display">
                            <p class="unassigned-hint">Ticket này chưa có người nhận</p>
                            <button class="btn-self-assign-detail" @onclick="SelfAssignTicket" disabled="@isSelfAssigning">
                                @if (isSelfAssigning)
                                {
                                    <span class="spinner-small"></span>
                                    <span>Đang xử lý...</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span>Tự nhận ticket này</span>
                                }
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="unassigned-hint">Ticket đã đóng</p>
                    }
                </div>

                <!-- Quick Actions Card -->
                <div class="action-card">
                    <h4>Thao tác nhanh</h4>
                    <div class="quick-actions">
                        @if (ticket.Status != 2 && !ticket.AssignedToId.HasValue)
                        {
                            <button class="quick-btn primary" @onclick="SelfAssignTicket" disabled="@isSelfAssigning">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                Nhận ticket này
                            </button>
                        }

                        @if (ticket.Status != 2 && IsMyTicket && ticket.Status != 1)
                        {
                            <button class="quick-btn warning" @onclick="StartProcessingTicket" disabled="@isUpdatingStatus">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                Chuyển sang Đang xử lý
                            </button>
                        }

                        @if (ticket.Status != 2 && IsMyTicket)
                        {
                            <button class="quick-btn success" @onclick="CloseTicketQuickly" disabled="@isUpdatingStatus">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Đánh dấu đã đóng
                            </button>
                        }

                        @if (ticket.Status == 2 && IsMyTicket)
                        {
                            <button class="quick-btn neutral" @onclick="ReopenTicket" disabled="@isUpdatingStatus">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="23 4 23 10 17 10"></polyline>
                                    <polyline points="1 20 1 14 7 14"></polyline>
                                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                                </svg>
                                Mở lại ticket
                            </button>
                        }

                        <button class="quick-btn neutral" @onclick='() => UseCannedResponse("Chúng tôi cần thêm thông tin để hỗ trợ bạn tốt hơn. Bạn có thể mô tả chi tiết hơn các bước gây ra vấn đề không?")'>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 1 1 5.82 1c0 2-3 3-3 3"></path>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            Yêu cầu thêm thông tin
                        </button>

                        @if (ticket.Category == 0)
                        {
                            <button class="quick-btn bug" @onclick='() => ShowActionNotification("🐛 Đã chuẩn bị nội dung chuyển lỗi cho team Dev. Bạn có thể gửi tiếp qua JIRA/nhóm kỹ thuật.", true)'>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                </svg>
                                Chuyển JIRA cho Dev
                            </button>
                        }
                        @if (ticket.Category == 3)
                        {
                            <button class="quick-btn sale" @onclick='() => ShowActionNotification("💼 Đã ghi nhận thao tác chuyển Sale Team. Vui lòng gắn tag sale trong quy trình nội bộ.", true)'>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                                Chuyển cho Sale Team
                            </button>
                        }
                        @if (ticket.Category == 2)
                        {
                            <button class="quick-btn support" @onclick='() => UseCannedResponse("Mình đã chuẩn bị hướng dẫn sử dụng phù hợp. Bạn vui lòng làm theo từng bước và phản hồi kết quả nhé.")'>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                                Gửi hướng dẫn sử dụng
                            </button>
                        }
                    </div>
                </div>

                <!-- Canned Responses Card -->
                <div class="action-card">
                    <h4>Trả lời mẫu</h4>
                    <div class="canned-responses">
                        @if (isLoadingCanned)
                        {
                            <div class="canned-loading">Đang tải mẫu phản hồi...</div>
                        }
                        else if (cannedResponses.Count == 0)
                        {
                            <div class="canned-loading">Chưa có mẫu phản hồi phù hợp.</div>
                        }
                        else
                        {
                            @foreach (var canned in cannedResponses.Take(6))
                            {
                                <button class="canned-btn" title="@canned.Text" @onclick='() => UseCannedResponse(canned.Text)'>
                                    @canned.Title
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Smart Action Toast Notification -->
    @if (showActionToast)
    {
        <div class="action-toast @(actionToastSuccess ? "success" : "info")">
            <span>@actionToastMessage</span>
            <button class="toast-close" @onclick="() => showActionToast = false">✕</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }
    
    private AgentTicketDetailDto? ticket;
    private List<CommentDto> comments = new();
    private string newComment = "";
    private bool isLoading = true;
    private bool isSending = false;
    private bool isUpdatingStatus = false;
    private bool isSelfAssigning = false;
    private bool showActionToast = false;
    private string actionToastMessage = "";
    private bool actionToastSuccess = true;
    private Guid? currentUserId = null;
    private bool isLoadingCanned = false;
    private List<CannedResponseOption> cannedResponses = new();
    private bool isGeneratingReplySuggestions = false;
    private string? replySuggestionError;
    private string? replySuggestionsSource;
    private List<AgentReplySuggestionItem> replySuggestions = new();
    private Dictionary<Guid, bool> suggestionFeedbackStates = new();
    private CancellationTokenSource? commentsPollingCts;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Id != Guid.Empty)
        {
            StopCommentsPolling();
            await LoadCurrentUser();
            await LoadTicketDetail();
            await LoadCannedResponses();
            StartCommentsPolling();
        }
    }

    private bool IsMyTicket =>
        ticket != null && currentUserId.HasValue && ticket.AssignedToId == currentUserId;

    private bool CanUpdateToStatus(int targetStatus)
    {
        if (ticket == null || isUpdatingStatus)
            return false;

        if (!IsMyTicket)
            return false;

        return ticket.Status != targetStatus;
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var response = await Http.GetAsync("api/Users/me");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var user = JsonSerializer.Deserialize<UserMeDto>(content, JsonOptions);
                currentUserId = user?.Id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading current user: {ex.Message}");
        }
    }

    private async Task LoadTicketDetail()
    {
        isLoading = true;
        try
        {
            Console.WriteLine($"DEBUG Agent: Loading ticket {Id}");
            
            var response = await Http.GetAsync($"api/Tickets/TicketDetails/{Id}");
            Console.WriteLine($"DEBUG Agent: Response status = {response.StatusCode}");
            
            var content = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"DEBUG Agent: Response = {(content?.Length > 300 ? content.Substring(0, 300) : content)}");
            
            if (response.IsSuccessStatusCode && !string.IsNullOrEmpty(content))
            {
                var ticketResponse = System.Text.Json.JsonSerializer.Deserialize<TicketDetailResponse>(content, new System.Text.Json.JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                });
                
                if (ticketResponse != null)
                {
                    ticket = new AgentTicketDetailDto
                    {
                        Id = ticketResponse.Id,
                        Title = ticketResponse.Title,
                        Description = ticketResponse.Description,
                        Priority = (int)ticketResponse.Priority,
                        Status = (int)ticketResponse.Status,
                        Category = ticketResponse.Category.HasValue ? (int?)ticketResponse.Category.Value : null,
                        SentimentScore = ticketResponse.SentimentScore,
                        UserName = ticketResponse.UserName,
                        UserEmail = ticketResponse.UserEmail,
                        ProductName = ticketResponse.ProductName,
                        CreatedAt = ticketResponse.CreatedAt,
                        Attachments = ticketResponse.Attachments,
                        AssignedToId = ticketResponse.AssignedToId,
                        AssignedToName = ticketResponse.AssignedToName
                    };
                    
                    if (ticketResponse.Comments != null)
                    {
                        comments = ticketResponse.Comments.Select(c => new CommentDto
                        {
                            Id = c.Id,
                            Content = c.Text,
                            IsFromAgent = c.IsFromAgent,
                            SenderName = c.UserName,
                            CreatedAt = c.CreatedAt
                        }).ToList();
                    }
                }
            }
            else
            {
                Console.WriteLine($"DEBUG Agent: API error {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ticket: {ex.Message}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
            ticket = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCannedResponses()
    {
        if (ticket == null)
            return;

        isLoadingCanned = true;
        try
        {
            HttpResponseMessage response;
            if (ticket.Category.HasValue)
            {
                var apiCategory = ticket.Category.Value switch
                {
                    0 => "Bug",
                    1 => "Feature",
                    2 => "Support",
                    3 => "Sale",
                    _ => ""
                };

                response = string.IsNullOrWhiteSpace(apiCategory)
                    ? await Http.GetAsync("api/CannedResponses")
                    : await Http.GetAsync($"api/CannedResponses/by-category/{apiCategory}");
            }
            else
            {
                response = await Http.GetAsync("api/CannedResponses");
            }

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var fromApi = JsonSerializer.Deserialize<List<CannedResponseOption>>(content, JsonOptions) ?? new List<CannedResponseOption>();
                cannedResponses = fromApi
                    .Where(x => !string.IsNullOrWhiteSpace(x.Title) && !string.IsNullOrWhiteSpace(x.Text))
                    .ToList();
            }

            if (cannedResponses.Count == 0)
            {
                cannedResponses = BuildDefaultCannedResponses(ticket.Category);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading canned responses: {ex.Message}");
            cannedResponses = BuildDefaultCannedResponses(ticket.Category);
        }
        finally
        {
            isLoadingCanned = false;
        }
    }

