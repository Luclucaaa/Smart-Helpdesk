@page "/admin/analytics"
@layout AdminLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Net.Http.Json

<PageTitle>Thống kê & Báo cáo - Admin Panel</PageTitle>

<div class="analytics-page">
    <!-- Page Header -->
    <div class="page-header">
        <div class="header-info">
            <h1>Thống kê & Báo cáo</h1>
            <p>Phân tích dữ liệu và hiệu suất hệ thống</p>
        </div>

        <div class="header-controls">
            <div class="date-filter">
                <label>Khoảng thời gian:</label>
                <select @bind="dateRange" @bind:after="LoadAnalytics">
                    <option value="7">7 ngày qua</option>
                    <option value="30">30 ngày qua</option>
                    <option value="90">90 ngày qua</option>
                    <option value="365">1 năm qua</option>
                </select>
            </div>

            <div class="date-filter">
                <label>Nhân viên:</label>
                <select @bind="selectedAgentId" @bind:after="LoadAnalytics">
                    <option value="">Tất cả nhân viên</option>
                    @foreach (var agent in agentFilterOptions)
                    {
                        <option value="@agent.Id">@agent.Name @agent.Surname</option>
                    }
                </select>
            </div>

            <button type="button" class="btn-export" @onclick="ExportAiCsv">
                Export AI CSV
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="loader"></div>
            <p>Đang tải dữ liệu thống kê...</p>
        </div>
    }
    else
    {
        <!-- Overview Stats -->
        <div class="overview-section">
            <div class="overview-card total">
                <div class="overview-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <div class="overview-content">
                    <span class="overview-value">@totalTickets</span>
                    <span class="overview-label">Tổng số yêu cầu</span>
                    <span class="overview-change positive">+@newTicketsThisPeriod trong kỳ</span>
                </div>
            </div>

            <div class="overview-card resolved">
                <div class="overview-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div class="overview-content">
                    <span class="overview-value">@resolvedTickets</span>
                    <span class="overview-label">Đã giải quyết</span>
                    <span class="overview-change">@resolutionRate% tỷ lệ giải quyết</span>
                </div>
            </div>

            <div class="overview-card avg-time">
                <div class="overview-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div class="overview-content">
                    <span class="overview-value">@avgResponseTime<small>h</small></span>
                    <span class="overview-label">Thời gian phản hồi TB</span>
                    <span class="overview-change">Mục tiêu: 24h</span>
                </div>
            </div>

            <div class="overview-card satisfaction">
                <div class="overview-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                        <line x1="9" y1="9" x2="9.01" y2="9"></line>
                        <line x1="15" y1="9" x2="15.01" y2="9"></line>
                    </svg>
                </div>
                <div class="overview-content">
                    <span class="overview-value">@satisfactionRate<small>%</small></span>
                    <span class="overview-label">Hài lòng khách hàng</span>
                    <span class="overview-change positive">Tích cực</span>
                </div>
            </div>
        </div>

        <!-- AI Analytics Section -->
        <div class="ai-analytics-section">
            <div class="section-header">
                <h3>Báo cáo phân tích AI</h3>
                <span class="section-subtitle">Hiệu quả gợi ý AI cho nhân viên hỗ trợ trong @dateRange ngày gần nhất</span>
            </div>

            <div class="ai-overview-grid">
                <div class="ai-card generated">
                    <span class="ai-card-label">Gợi ý AI đã sinh</span>
                    <span class="ai-card-value">@aiSuggestionsGenerated</span>
                </div>
                <div class="ai-card accepted">
                    <span class="ai-card-label">Gợi ý được chọn dùng</span>
                    <span class="ai-card-value">@aiSuggestionsAccepted</span>
                </div>
                <div class="ai-card acceptance">
                    <span class="ai-card-label">Tỷ lệ chấp nhận</span>
                    <span class="ai-card-value">@aiAcceptanceRate<small>%</small></span>
                </div>
                <div class="ai-card helpful">
                    <span class="ai-card-label">Tỷ lệ hữu ích</span>
                    <span class="ai-card-value">@aiHelpfulnessRate<small>%</small></span>
                </div>
            </div>

            <div class="ai-detail-grid">
                <div class="ai-detail-card">
                    <h4>Phân bổ theo nguồn gợi ý</h4>
                    @if (aiSourceStats.Count == 0)
                    {
                        <p class="ai-empty">Chưa có dữ liệu nguồn gợi ý.</p>
                    }
                    else
                    {
                        @foreach (var source in aiSourceStats)
                        {
                            <div class="ai-source-row">
                                <div class="ai-source-top">
                                    <span class="source-name">@source.Source</span>
                                    <span class="source-value">@source.Count</span>
                                </div>
                                <div class="source-track">
                                    <div class="source-fill" style="width:@GetAiSourcePercentage(source.Count)%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="ai-detail-card">
                    <h4>Xu hướng AI theo ngày</h4>
                    @if (aiSuggestionTrends.Count == 0)
                    {
                        <p class="ai-empty">Chưa có dữ liệu xu hướng AI.</p>
                    }
                    else
                    {
                        <div class="ai-trend-bars">
                            @foreach (var trend in aiSuggestionTrends.TakeLast(14))
                            {
                                <div class="trend-item" title="@trend.Date.ToString("dd/MM"): @trend.GeneratedCount gợi ý, @trend.AcceptedCount được dùng">
                                    <div class="trend-stack">
                                        <div class="trend-generated" style="height:@GetTrendHeight(trend.GeneratedCount)%"></div>
                                        <div class="trend-accepted" style="height:@GetTrendHeight(trend.AcceptedCount)%"></div>
                                    </div>
                                    <span class="trend-date">@trend.Date.ToString("dd/MM")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="ai-detail-card weekly-card">
                    <h4>So sánh tuần gần nhất</h4>
                    <div class="weekly-row">
                        <span>Acceptance tuần này</span>
                        <strong>@currentWeekAcceptanceRate.ToString("F1")%</strong>
                    </div>
                    <div class="weekly-row">
                        <span>Acceptance tuần trước</span>
                        <strong>@previousWeekAcceptanceRate.ToString("F1")%</strong>
                    </div>
                    <div class="weekly-delta @(weeklyAcceptanceDelta >= 0 ? "positive" : "negative")">
                        @if (weeklyAcceptanceDelta >= 0)
                        {
                            <span>▲ +@weeklyAcceptanceDelta.ToString("F1")% so với tuần trước</span>
                        }
                        else
                        {
                            <span>▼ @weeklyAcceptanceDelta.ToString("F1")% so với tuần trước</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-grid">
            <!-- Tickets by Product -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3>Yêu cầu theo Sản phẩm</h3>
                    <span class="chart-subtitle">Phân bổ yêu cầu theo từng sản phẩm</span>
                </div>
                <div class="chart-content">
                    <div class="pie-chart-container">
                        <div class="pie-chart">
                            @{
                                var total = productStats.Sum(p => p.TicketCount);
                                double currentAngle = 0;
                            }
                            @foreach (var (product, index) in productStats.Select((p, i) => (p, i)))
                            {
                                var percentage = total > 0 ? (double)product.TicketCount / total * 100 : 0;
                                var color = GetChartColor(index);
                                <div class="pie-segment" 
                                     style="--start-angle: @currentAngle.ToString("F1")deg; --end-angle: @((currentAngle + percentage * 3.6).ToString("F1"))deg; --color: @color">
                                </div>
                                currentAngle += percentage * 3.6;
                            }
                            <div class="pie-center">
                                <span class="center-value">@total</span>
                                <span class="center-label">Tổng</span>
                            </div>
                        </div>
                        <div class="pie-legend">
                            @foreach (var (product, index) in productStats.Select((p, i) => (p, i)))
                            {
                                var percentage = total > 0 ? (double)product.TicketCount / total * 100 : 0;
                                <div class="legend-item">
                                    <span class="legend-color" style="background: @GetChartColor(index)"></span>
                                    <span class="legend-text">@product.Name</span>
                                    <span class="legend-value">@product.TicketCount (@percentage.ToString("F1")%)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tickets by Category -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3>Yêu cầu theo Phân loại</h3>
                    <span class="chart-subtitle">Phân loại yêu cầu hỗ trợ</span>
                </div>
                <div class="chart-content">
                    <div class="bar-chart">
                        <div class="bar-item">
                            <div class="bar-label">
                                <span class="bar-name">Lỗi kỹ thuật</span>
                                <span class="bar-count">@bugCount</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill bug" style="width: @GetPercentage(bugCount)%"></div>
                            </div>
                        </div>
                        <div class="bar-item">
                            <div class="bar-label">
                                <span class="bar-name">Yêu cầu tính năng</span>
                                <span class="bar-count">@featureCount</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill feature" style="width: @GetPercentage(featureCount)%"></div>
                            </div>
                        </div>
                        <div class="bar-item">
                            <div class="bar-label">
                                <span class="bar-name">Hỗ trợ sử dụng</span>
                                <span class="bar-count">@supportCount</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill support" style="width: @GetPercentage(supportCount)%"></div>
                            </div>
                        </div>
                        <div class="bar-item">
                            <div class="bar-label">
                                <span class="bar-name">Tư vấn mua hàng</span>
                                <span class="bar-count">@saleCount</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill sale" style="width: @GetPercentage(saleCount)%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tickets by Status -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3>Yêu cầu theo Trạng thái</h3>
                    <span class="chart-subtitle">Tiến độ xử lý yêu cầu</span>
                </div>
                <div class="chart-content">
                    <div class="status-cards">
                        <div class="status-card open">
                            <div class="status-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </div>
                            <div class="status-info">
                                <span class="status-value">@openCount</span>
                                <span class="status-label">Mới</span>
                            </div>
                        </div>
                        <div class="status-card in-progress">
                            <div class="status-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div class="status-info">
                                <span class="status-value">@inProgressCount</span>
                                <span class="status-label">Đang xử lý</span>
                            </div>
                        </div>
                        <div class="status-card closed">
                            <div class="status-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                            </div>
                            <div class="status-info">
                                <span class="status-value">@closedCount</span>
                                <span class="status-label">Đã đóng</span>
                            </div>
                        </div>
                    </div>
                    <div class="progress-bar-section">
                        <div class="progress-track">
                            <div class="progress-segment open" style="width: @GetStatusPercentage(openCount)%"></div>
                            <div class="progress-segment in-progress" style="width: @GetStatusPercentage(inProgressCount)%"></div>
                            <div class="progress-segment closed" style="width: @GetStatusPercentage(closedCount)%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Priority Distribution -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3>Phân bổ Độ ưu tiên</h3>
                    <span class="chart-subtitle">Yêu cầu theo mức độ khẩn cấp</span>
                </div>
                <div class="chart-content">
                    <div class="priority-distribution">
                        <div class="priority-item high">
                            <div class="priority-ring">
                                <svg viewBox="0 0 36 36">
                                    <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                    <path class="ring-fill" stroke-dasharray="@GetPriorityPercentage(highPriorityCount), 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                </svg>
                                <span class="ring-value">@highPriorityCount</span>
                            </div>
                            <span class="priority-label">Cao</span>
                        </div>
                        <div class="priority-item medium">
                            <div class="priority-ring">
                                <svg viewBox="0 0 36 36">
                                    <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                    <path class="ring-fill" stroke-dasharray="@GetPriorityPercentage(mediumPriorityCount), 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                </svg>
                                <span class="ring-value">@mediumPriorityCount</span>
                            </div>
                            <span class="priority-label">Trung bình</span>
                        </div>
                        <div class="priority-item low">
                            <div class="priority-ring">
                                <svg viewBox="0 0 36 36">
                                    <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                    <path class="ring-fill" stroke-dasharray="@GetPriorityPercentage(lowPriorityCount), 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                </svg>
                                <span class="ring-value">@lowPriorityCount</span>
                            </div>
                            <span class="priority-label">Thấp</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Agents Section -->
        <div class="agents-section">
            <div class="section-header">
                <h3>Hiệu suất Nhân viên Hỗ trợ</h3>
                <span class="section-subtitle">Xếp hạng theo số yêu cầu đã xử lý</span>
            </div>
            <div class="agents-table-container">
                @if (topAgents.Count == 0)
                {
                    <div class="empty-state small">
                        <p>Chưa có dữ liệu nhân viên</p>
                    </div>
                }
                else
                {
                    <table class="agents-table">
                        <thead>
                            <tr>
                                <th>Xếp hạng</th>
                                <th>Nhân viên</th>
                                <th>Yêu cầu đã xử lý</th>
                                <th>Đang xử lý</th>
                                <th>Hiệu suất</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (agent, index) in topAgents.Select((a, i) => (a, i)))
                            {
                                <tr>
                                    <td class="rank-cell">
                                        <span class="rank @(index < 3 ? "top" : "")">@(index + 1)</span>
                                    </td>
                                    <td class="agent-cell">
                                        <div class="agent-avatar">
                                            @GetInitials(agent.Name, agent.Surname)
                                        </div>
                                        <div class="agent-info">
                                            <span class="agent-name">@agent.Name @agent.Surname</span>
                                            <span class="agent-email">@agent.Email</span>
                                        </div>
                                    </td>
                                    <td class="center">
                                        <span class="resolved-count">@agent.ResolvedCount</span>
                                    </td>
                                    <td class="center">
                                        <span class="pending-count">@agent.PendingCount</span>
                                    </td>
                                    <td>
                                        <div class="performance-bar">
                                            <div class="performance-fill" style="width: @agent.Performance%"></div>
                                            <span class="performance-text">@agent.Performance%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private int dateRange = 30;
    private string selectedAgentId = string.Empty;

    // Overview stats
    private int totalTickets = 0;
    private int newTicketsThisPeriod = 0;
    private int resolvedTickets = 0;
    private double resolutionRate = 0;
    private double avgResponseTime = 0;
    private double satisfactionRate = 0;

    // Category counts
    private int bugCount = 0;
    private int featureCount = 0;
    private int supportCount = 0;
    private int saleCount = 0;

    // Status counts
    private int openCount = 0;
    private int inProgressCount = 0;
    private int closedCount = 0;

    // Priority counts
    private int highPriorityCount = 0;
    private int mediumPriorityCount = 0;
    private int lowPriorityCount = 0;

    // AI analytics
    private int aiSuggestionsGenerated = 0;
    private int aiSuggestionsAccepted = 0;
    private double aiAcceptanceRate = 0;
    private double aiHelpfulnessRate = 0;
    private double currentWeekAcceptanceRate = 0;
    private double previousWeekAcceptanceRate = 0;
    private double weeklyAcceptanceDelta = 0;
    private List<AiSourceStat> aiSourceStats = new();
    private List<AiSuggestionTrend> aiSuggestionTrends = new();
    private List<AgentFilterOption> agentFilterOptions = new();

    private List<ProductStat> productStats = new();
    private List<AgentStat> topAgents = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAgentFilterOptions();
        await LoadAnalytics();
    }

    private async Task LoadAgentFilterOptions()
    {
        try
        {
            var agents = await Http.GetFromJsonAsync<List<AgentFilterOption>>("api/Users/agents") ?? new List<AgentFilterOption>();
            agentFilterOptions = agents
                .OrderBy(x => x.Name)
                .ThenBy(x => x.Surname)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading agent filter options: {ex.Message}");
            agentFilterOptions = new List<AgentFilterOption>();
        }
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        try
        {
            var query = string.IsNullOrWhiteSpace(selectedAgentId)
                ? $"api/Tickets/AdminDashboard?days={dateRange}"
                : $"api/Tickets/AdminDashboard?days={dateRange}&agentId={selectedAgentId}";

            var dashboard = await Http.GetFromJsonAsync<AdminDashboardResponse>(query);
            if (dashboard == null)
            {
                return;
            }

            totalTickets = dashboard.TotalTickets;
            openCount = dashboard.OpenTickets;
            inProgressCount = dashboard.InProgressTickets;
            closedCount = dashboard.ClosedTickets;
            resolvedTickets = dashboard.ClosedTickets;

            newTicketsThisPeriod = dashboard.TicketTrends?.Sum(x => x.NewTickets) ?? 0;
            resolutionRate = totalTickets > 0 ? Math.Round((double)resolvedTickets / totalTickets * 100, 1) : 0;

            bugCount = dashboard.BugCount;
            featureCount = dashboard.FeatureCount;
            supportCount = dashboard.SupportCount;
            saleCount = dashboard.SaleCount;

            highPriorityCount = dashboard.HighPriorityCount;
            mediumPriorityCount = dashboard.MediumPriorityCount;
            lowPriorityCount = dashboard.LowPriorityCount;

            var agentResolutionTimes = dashboard.AgentStats?
                .Select(x => x.AverageResolutionTimeHours)
                .Where(x => x > 0)
                .ToList() ?? new List<float>();
            avgResponseTime = agentResolutionTimes.Count > 0
                ? Math.Round(agentResolutionTimes.Average(), 1)
                : 0;

            if (dashboard.AverageCsatRating > 0)
            {
                satisfactionRate = Math.Round(dashboard.AverageCsatRating * 20.0, 1);
            }
            else
            {
                var sentimentTotal = dashboard.PositiveSentimentCount + dashboard.NegativeSentimentCount + dashboard.NeutralSentimentCount;
                satisfactionRate = sentimentTotal > 0
                    ? Math.Round((double)dashboard.PositiveSentimentCount / sentimentTotal * 100, 1)
                    : 0;
            }

            productStats = (dashboard.ProductStats ?? new List<ProductStatData>())
                .Select(p => new ProductStat
                {
                    Name = p.ProductName,
                    TicketCount = p.TotalTickets
                })
                .OrderByDescending(p => p.TicketCount)
                .Take(6)
                .ToList();

            topAgents = (dashboard.AgentStats ?? new List<AgentStatData>())
                .Select(a => new AgentStat
                {
                    Name = ExtractFirstName(a.AgentName),
                    Surname = ExtractLastName(a.AgentName),
                    Email = string.Empty,
                    ResolvedCount = a.ClosedTickets,
                    PendingCount = a.OpenTickets,
                    Performance = a.AssignedTickets > 0
                        ? (int)Math.Round((double)a.ClosedTickets / a.AssignedTickets * 100)
                        : 0
                })
                .OrderByDescending(a => a.ResolvedCount)
                .Take(6)
                .ToList();

            aiSuggestionsGenerated = dashboard.AiSuggestionsGenerated;
            aiSuggestionsAccepted = dashboard.AiSuggestionsAccepted;
            aiAcceptanceRate = dashboard.AiAcceptanceRate;
            aiHelpfulnessRate = dashboard.AiHelpfulnessRate;

            aiSourceStats = (dashboard.AiSourceStats ?? new List<AiSourceStatData>())
                .Select(x => new AiSourceStat
                {
                    Source = x.Source,
                    Count = x.Count
                })
                .ToList();

            aiSuggestionTrends = (dashboard.AiSuggestionTrends ?? new List<AiSuggestionTrendData>())
                .Select(x => new AiSuggestionTrend
                {
                    Date = x.Date,
                    GeneratedCount = x.GeneratedCount,
                    AcceptedCount = x.AcceptedCount
                })
                .ToList();

            CalculateWeeklyAcceptanceComparison();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetChartColor(int index)
    {
        var colors = new[] { "#e94560", "#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899" };
        return colors[index % colors.Length];
    }

    private double GetAiSourcePercentage(int count)
    {
        var max = aiSourceStats.Count > 0 ? aiSourceStats.Max(x => x.Count) : 0;
        return max > 0 ? Math.Round((double)count / max * 100, 1) : 0;
    }

    private double GetTrendHeight(int count)
    {
        var max = aiSuggestionTrends.Count > 0 ? aiSuggestionTrends.Max(x => x.GeneratedCount) : 0;
        return max > 0 ? Math.Round((double)count / max * 100, 1) : 0;
    }

    private void CalculateWeeklyAcceptanceComparison()
    {
        var ordered = aiSuggestionTrends.OrderBy(x => x.Date).ToList();

        var currentStartIndex = Math.Max(0, ordered.Count - 7);
        var previousStartIndex = Math.Max(0, currentStartIndex - 7);

        var currentWeek = ordered.Skip(currentStartIndex).Take(ordered.Count - currentStartIndex).ToList();
        var previousWeek = ordered.Skip(previousStartIndex).Take(currentStartIndex - previousStartIndex).ToList();

        var currentGenerated = currentWeek.Sum(x => x.GeneratedCount);
        var currentAccepted = currentWeek.Sum(x => x.AcceptedCount);
        var previousGenerated = previousWeek.Sum(x => x.GeneratedCount);
        var previousAccepted = previousWeek.Sum(x => x.AcceptedCount);

        currentWeekAcceptanceRate = currentGenerated > 0
            ? Math.Round((double)currentAccepted / currentGenerated * 100, 1)
            : 0;
        previousWeekAcceptanceRate = previousGenerated > 0
            ? Math.Round((double)previousAccepted / previousGenerated * 100, 1)
            : 0;

        weeklyAcceptanceDelta = Math.Round(currentWeekAcceptanceRate - previousWeekAcceptanceRate, 1);
    }

    private async Task ExportAiCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Metric,Value");
        sb.AppendLine($"DateRangeDays,{dateRange}");
        sb.AppendLine($"AgentFilter,{(string.IsNullOrWhiteSpace(selectedAgentId) ? "all" : selectedAgentId)}");
        sb.AppendLine($"AiSuggestionsGenerated,{aiSuggestionsGenerated}");
        sb.AppendLine($"AiSuggestionsAccepted,{aiSuggestionsAccepted}");
        sb.AppendLine($"AiAcceptanceRate,{aiAcceptanceRate:F2}");
        sb.AppendLine($"AiHelpfulnessRate,{aiHelpfulnessRate:F2}");
        sb.AppendLine($"CurrentWeekAcceptanceRate,{currentWeekAcceptanceRate:F2}");
        sb.AppendLine($"PreviousWeekAcceptanceRate,{previousWeekAcceptanceRate:F2}");
        sb.AppendLine($"WeeklyAcceptanceDelta,{weeklyAcceptanceDelta:F2}");
        sb.AppendLine();

        sb.AppendLine("Source,Count");
        foreach (var row in aiSourceStats)
        {
            sb.AppendLine($"\"{row.Source.Replace("\"", "\"\"")}\",{row.Count}");
        }

        sb.AppendLine();
        sb.AppendLine("Date,Generated,Accepted");
        foreach (var trend in aiSuggestionTrends.OrderBy(x => x.Date))
        {
            sb.AppendLine($"{trend.Date:yyyy-MM-dd},{trend.GeneratedCount},{trend.AcceptedCount}");
        }

        var fileName = $"ai-analytics-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
        var csvDataUrl = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(sb.ToString());
        var downloadScript = $"(function(){{var a=document.createElement('a');a.href='{csvDataUrl}';a.download='{fileName}';document.body.appendChild(a);a.click();a.remove();}})();";
        await JS.InvokeVoidAsync("eval", downloadScript);
        Console.WriteLine($"AI analytics exported: {fileName}");
    }

    private double GetPercentage(int count)
    {
        var max = Math.Max(Math.Max(bugCount, featureCount), Math.Max(supportCount, saleCount));
        return max > 0 ? (double)count / max * 100 : 0;
    }

    private double GetStatusPercentage(int count)
    {
        var total = openCount + inProgressCount + closedCount;
        return total > 0 ? (double)count / total * 100 : 0;
    }

    private double GetPriorityPercentage(int count)
    {
        var total = highPriorityCount + mediumPriorityCount + lowPriorityCount;
        return total > 0 ? Math.Round((double)count / total * 100, 0) : 0;
    }

    private string GetInitials(string name, string surname)
    {
        var first = !string.IsNullOrEmpty(name) ? name[0].ToString().ToUpper() : "";
        var last = !string.IsNullOrEmpty(surname) ? surname[0].ToString().ToUpper() : "";
        return first + last;
    }

    private static string ExtractFirstName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "Agent";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[0] : "Agent";
    }

    private static string ExtractLastName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return string.Empty;

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? string.Join(" ", parts.Skip(1)) : string.Empty;
    }

